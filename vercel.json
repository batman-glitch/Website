{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m pip install --target /tmp/blessson-build-deps -r requirements.txt && PYTHONPATH=/tmp/blessson-build-deps npm run build",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/api/index?__path=/login"
    },
    {
      "source": "/register",
      "destination": "/api/index?__path=/register"
    },
    {
      "source": "/password/:path*",
      "destination": "/api/index?__path=/password/:path*"
    },
    {
      "source": "/client/:path*",
      "destination": "/api/index?__path=/client/:path*"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/api/index?__path=/dashboard/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?__path=/admin/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/index?__path=/admin"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index?__path=/api/auth/:path*"
    },
    {
      "source": "/api/client/:path*",
      "destination": "/api/index?__path=/api/client/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index?__path=/api/admin/:path*"
    },
    {
      "source": "/api/files/:path*",
      "destination": "/api/index?__path=/api/files/:path*"
    },
    {
      "source": "/api/portfolio",
      "destination": "/api/index?__path=/api/portfolio"
    },
    {
      "source": "/api/portfolio/:path*",
      "destination": "/api/index?__path=/api/portfolio/:path*"
    },
    {
      "source": "/api/inquiries",
      "destination": "/api/index?__path=/api/inquiries"
    },
    {
      "source": "/api/inquiries/:path*",
      "destination": "/api/index?__path=/api/inquiries/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/admin.html",
      "destination": "/dashboard/admin/",
      "permanent": false
    },
    {
      "source": "/server.py",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data: https://*.public.blob.vercel-storage.com; media-src 'self' https://*.public.blob.vercel-storage.com; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://blob.vercel-storage.com https://vercel.com/api/blob https://vercel.com/api/blob/ https://*.blob.vercel-storage.com https://*.public.blob.vercel-storage.com"
        }
      ]
    },
    {
      "source": "/assets/studio-blob.bundle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{config,studio,templates,lib}/**",
      "maxDuration": 60
    }
  }
}
